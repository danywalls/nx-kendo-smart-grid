{
  "name": "angular-smart-grid",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "includedScripts": [],
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/angular-smart-grid/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/angular-smart-grid",
        "browser": "apps/angular-smart-grid/src/main.ts",
        "polyfills": ["@angular/localize/init"],
        "tsConfig": "apps/angular-smart-grid/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/angular-smart-grid/public"
          }
        ],
        "styles": ["apps/angular-smart-grid/src/styles.css"],
        "security": {
          "allowedHosts": []
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "6mb",
              "maximumError": "7mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "angular-smart-grid:build:production"
        },
        "development": {
          "buildTarget": "angular-smart-grid:build:development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/angular-smart-grid/src"]
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "angular-smart-grid:build",
        "staticFilePath": "dist/apps/angular-smart-grid/browser",
        "spa": true
      }
    }
  }
}
